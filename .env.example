# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: dev server port (standard 3000)
PORT=3000

# VITE_API_URL: Base URL for configurator backend API
VITE_API_URL="/api"

# Shopify Store & API Configuration (Mock or Production)
VITE_SHOPIFY_STORE_DOMAIN="mvp-visuals-demo.myshopify.com"
VITE_SHOPIFY_PUBLIC_TOKEN="mock_public_token_for_technical_test"
